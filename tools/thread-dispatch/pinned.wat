(module
  (import "wasi_snapshot_preview1" "proc_exit" (func $exit (param i32)))
  (memory 1)
  (export "memory" (memory 0))
  (data (i32.const 0) "\01\00\00\00\01\00\00\00\01\00\00\00\01\00\00\00\01\00\00\00\01\00\00\00\01\00\00\00\01\00\00\00\01\00\00\00\01\00\00\00\01\00\00\00\01\00\00\00\01\00\00\00\01\00\00\00\01\00\00\00\01\00\00\00\02\00\00\00\00\00\00\00\03\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00")
  (type $h (func (param i32 i64 i64)))
  (table 4 funcref)
  (elem (i32.const 0) $h_halt $h_addi $h_dec $h_brnz)
  ;; $disp(pc, r0, r1): read op at pc, tail-call its handler with state
  (func $disp (param $pc i32) (param $r0 i64) (param $r1 i64)
    (return_call_indirect (type $h)
      (local.get $pc) (local.get $r0) (local.get $r1)
      (i32.wrap_i64 (i64.and (i64.load (i32.mul (local.get $pc) (i32.const 8))) (i64.const 0xff)))))
  (func $h_halt (param $pc i32) (param $r0 i64) (param $r1 i64)
    (call $exit (i32.wrap_i64 (i64.and (local.get $r0) (i64.const 0xff)))))
  (func $h_addi (param $pc i32) (param $r0 i64) (param $r1 i64)
    (return_call $disp
      (i32.add (local.get $pc) (i32.const 1))
      (i64.add (local.get $r0) (i64.shr_u (i64.load (i32.mul (local.get $pc) (i32.const 8))) (i64.const 32)))
      (local.get $r1)))
  (func $h_dec (param $pc i32) (param $r0 i64) (param $r1 i64)
    (return_call $disp
      (i32.add (local.get $pc) (i32.const 1))
      (local.get $r0)
      (i64.sub (local.get $r1) (i64.const 1))))
  (func $h_brnz (param $pc i32) (param $r0 i64) (param $r1 i64)
    (return_call $disp
      (select (i32.wrap_i64 (i64.shr_u (i64.load (i32.mul (local.get $pc) (i32.const 8))) (i64.const 32)))
              (i32.add (local.get $pc) (i32.const 1))
              (i64.ne (local.get $r1) (i64.const 0)))
      (local.get $r0) (local.get $r1)))
  (func $run (export "_start")
    (call $disp (i32.const 0) (i64.const 0) (i64.const 200000000))))
