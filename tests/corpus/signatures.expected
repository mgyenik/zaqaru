# What inference must recover from signatures.c, at every configuration.
#
# Every line here is also the true C signature. That is the point of the file:
# it is ground truth written down, not a record of current behaviour, so a
# line that stops matching is a regression rather than something to update.
#
# The two functions deliberately absent are listed in tests/inference.rs with
# the reason each is beyond reach. They are absent rather than recorded with
# whatever inference happens to say, because writing down a wrong answer as
# "expected" is how a limitation stops being visible.

add_ints(i32, i32) -> i32
add_longs(i64, i64) -> i64
add_doubles(f64, f64) -> f64
add_floats(f32, f32) -> f32

six_integers(i32, i32, i32, i32, i32, i32) -> i32
eight_doubles(f64, f64, f64, f64, f64, f64, f64, f64) -> f64

# Pointers are i32 because the target is wasm32. Recovering that takes
# following the value out of its argument register: at -O0 both compilers
# spill it to the stack and dereference a reload, and gcc at -O1 copies it
# into another register first.
dereference(i32) -> i32
store_through(i32, i32)
sum_array(i32, i32) -> i32

bump_counter()

# Forwarding: at -O2 these never touch their argument registers at all, so
# what they take is only knowable from what they call.
forward_both(i32, i32) -> i32
forward_double(f64, f64) -> f64
forward_and_adjust(i32) -> i32

# Cycles in the call graph, direct and mutual.
countdown(i32) -> i32
is_odd(i32) -> i32
is_even(i32) -> i32

widen(i32) -> i64
